{
  "name": "cookie-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fetch:icon-font": "node scripts/fetch-icon-font.mjs",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "lint": "oxlint . && eslint . --cache",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache",
    "format": "oxfmt --ignore-path .gitignore src/ && prettier --write .",
    "format:check": "oxfmt --check --ignore-path .gitignore src/ && prettier --check ."
  },
  "dependencies": {
    "@auth0/auth0-vue": "^2.11.0",
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.31.7",
    "@editorjs/header": "^2.8.9",
    "@editorjs/image": "^2.10.3",
    "@editorjs/list": "^2.0.9",
    "@excalidraw/excalidraw": "^0.18.1",
    "@sentry/vue": "^11.8.0",
    "@supabase/realtime-js": "^2.118.0",
    "@univerjs/preset-sheets-conditional-formatting": "^1.1.0",
    "@univerjs/preset-sheets-core": "^1.1.0",
    "@univerjs/preset-sheets-data-validation": "^1.1.0",
    "@univerjs/preset-sheets-filter": "^1.1.0",
    "@univerjs/preset-sheets-find-replace": "^1.1.0",
    "@univerjs/preset-sheets-hyper-link": "^1.1.0",
    "@univerjs/preset-sheets-sort": "^1.1.0",
    "@univerjs/presets": "^1.1.0",
    "dompurify": "^3.4.17",
    "editorjs-drag-drop": "^1.1.16",
    "highlight.js": "^11.12.0",
    "html2pdf.js": "^0.14.0",
    "jose": "^6.2.12",
    "pinia": "^4.1.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.34.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oxlint/plugins": "^1.88.0",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^11.8.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.88.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "prettier": "3.9.10",
    "vite": "^8.3.4",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
